{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_STUDENT_BUCKET/input/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_STUDENT_BUCKET/processed/*",
        "arn:aws:s3:::REPLACE_STUDENT_BUCKET/error/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-southeast-1:REPLACE_ACCOUNT_ID:function:wsc2026-student-score-function"
    }
  ]
}
