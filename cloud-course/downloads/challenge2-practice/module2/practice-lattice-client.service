[Unit]
Description=Practice VPC Lattice Client Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/practice-lattice-client
EnvironmentFile=/etc/practice-lattice-client.env
ExecStart=/opt/practice-lattice-client/venv/bin/python /opt/practice-lattice-client/client.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
