[Unit]
Description=Practice Orders DynamoDB Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/practice-orders
Environment=AWS_REGION=ap-northeast-2
ExecStart=/opt/practice-orders/venv/bin/python /opt/practice-orders/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
