{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPracticeTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:*:table/practice-orders",
        "arn:aws:dynamodb:ap-northeast-2:*:table/practice-orders/index/*",
        "arn:aws:dynamodb:ap-northeast-2:*:table/practice-products",
        "arn:aws:dynamodb:ap-northeast-2:*:table/practice-products/index/*",
        "arn:aws:dynamodb:ap-northeast-2:*:table/practice-sessions"
      ]
    }
  ]
}
